# Machine-local state written by DMS through the out-of-store symlinks:
# monitor layout and settings (contains absolute paths for this machine).
config/hypr/dms/outputs.lua
config/hypr/dms/outputs.conf

# DMS 1.6.3 dropped the .conf-plus-shim bridge and writes these as native Lua
# itself ("Auto-generated by DMS - do not edit manually"), reloading Hyprland
# afterwards. colors.lua is derived from the selected theme, so tracking these
# turns every theme change into a repo diff. binds.lua stays tracked — it is
# hand-written, despite living in this directory.
config/hypr/dms/colors.lua
config/hypr/dms/cursor.lua
config/hypr/dms/layout.lua
config/hypr/dms/windowrules.lua
config/hypr/.dms-backups/
config/DankMaterialShell/settings.json
config/DankMaterialShell/session.json
config/DankMaterialShell/*.log
result
