# Machine-local state written by DMS through the out-of-store symlinks:
# monitor layout and settings (contains absolute paths for this machine).
config/hypr/dms/outputs.lua
config/hypr/dms/outputs.conf

# DMS 1.6.3 dropped the .conf-plus-shim bridge and writes these as native Lua
# itself ("Auto-generated by DMS - do not edit manually"), reloading Hyprland
# afterwards. colors.lua is derived from the selected theme, so tracking these
# turns every theme change into a repo diff. binds.lua stays tracked — it is
# hand-written, despite living in this directory.
config/hypr/dms/colors.lua
config/hypr/dms/cursor.lua
config/hypr/dms/layout.lua
config/hypr/dms/windowrules.lua
config/hypr/.dms-backups/
config/DankMaterialShell/settings.json
config/DankMaterialShell/session.json
config/DankMaterialShell/*.log

# DMS 1.6.3 writes hyprland.lua.backup<epoch> beside the file it is about to
# touch rather than into the .dms-backups/ directory above, so these pile up in
# the worktree -- one per reload.
config/hypr/hyprland.lua.backup*

# Also derived from the machine-local theme selection, same reason as colors.lua
# above: ghostty's palette is regenerated on every theme change. Nothing reads
# firefox.css at all -- the Firefox profile has no chrome/userChrome.css and
# toolkit.legacyUserProfileCustomizations.stylesheets is unset.
config/ghostty/themes/dankcolors
config/DankMaterialShell/firefox.css

# Theme previews are rendered by DMS, and tokyoNight is its registry copy of the
# upstream theme (author "Avenge Media"), re-fetched on demand. The adapted
# tokyoNightNightMoon/theme.json stays tracked: that one is hand-written, and is
# what settings.json actually selects.
config/DankMaterialShell/themes/*/preview-*.svg
config/DankMaterialShell/themes/tokyoNight/

# One marker per version whose changelog DMS has shown.
config/DankMaterialShell/.changelog-*

result
